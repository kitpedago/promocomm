# PromoComm — production chez le client. Copier en .env et remplir.
# Les valeurs vides sont OBLIGATOIRES : le compose refuse de démarrer tant
# qu'elles ne sont pas renseignées (pas de mot de passe par défaut).
# Générer un secret :  openssl rand -base64 24 | tr -d '/+='
# Un « $ » dans une valeur doit être doublé (« $$ ») : Compose l'interprète
# sinon comme une variable, et la valeur arrive tronquée dans le conteneur.

# --- PostgreSQL (conteneur promocomm-db) ---
# Compte d'administration de l'instance (superutilisateur) : jamais utilisé par l'application.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=promocomm
# Compte applicatif (NOSUPERUSER CREATEDB CREATEROLE, propriétaire de la base),
# créé au premier démarrage par init-app-role.sh. Installation existante : cf. README.
APP_DB_USER=promocomm
APP_DB_PASSWORD=

# --- URL vue par les navigateurs (Better Auth s'en sert pour les cookies) ---
APP_URL=http://192.168.1.10:3020
# Autres origines acceptées pour la connexion (virgules) : autres noms d'hôte,
# IP, reverse proxy… Sans ça, un accès par un autre nom affiche les pages mais
# refuse la connexion (« Invalid origin »).
TRUSTED_ORIGINS=

# --- Better Auth : générer avec  npx -y @better-auth/cli secret ---
BETTER_AUTH_SECRET=

# --- Base miroir aux noms SQL Server (page /admin/miroir). Vide = désactivé. ---
MIROIR_DB=promocomm_miroir

# --- Tag de l'image à déployer (latest ou sha court, cf. scripts/release.ps1) ---
PROMOCOMM_TAG=latest
