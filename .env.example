# --- PostgreSQL (conteneur promocomm-db) ---
POSTGRES_USER=promocomm
POSTGRES_PASSWORD=change-me
POSTGRES_DB=promocomm

# --- App (dev sur l'hôte : la db est exposée sur 127.0.0.1:5443) ---
DATABASE_URL=postgresql://promocomm:change-me@127.0.0.1:5443/promocomm

# --- Better Auth ---
# Générer un secret : npx -y @better-auth/cli secret
BETTER_AUTH_URL=http://localhost:3020
BETTER_AUTH_SECRET=change-me

# --- URL publique de l'instance dockerisée (profil app) ---
APP_URL=https://promocomm.gd.solutions

# --- SQL Server d'ETL (profil etl, phase de dev uniquement) ---
# Complexité requise : 8+ caractères, 3 catégories parmi maj/min/chiffre/symbole
MSSQL_SA_PASSWORD=change-me
# Depuis l'hôte (npm run dev) :
MSSQL_URL="Server=127.0.0.1,14330;Database=master;User Id=sa;Password=change-me;TrustServerCertificate=true"
# Depuis le conteneur app :
MSSQL_URL_DOCKER="Server=promocomm-mssql,1433;Database=master;User Id=sa;Password=change-me;TrustServerCertificate=true"

# --- Seed du premier compte admin (scripts/seed-admin.ts) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
ADMIN_NAME=Admin
